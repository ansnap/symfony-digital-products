{% extends 'base.html.twig' %}

{% block body %}
    <h1>Товар</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Название</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Описание</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Цена</th>
                <td>{{ product.price }}</td>
            </tr>
        </tbody>
    </table>

    {% if is_granted('PRODUCT_EDIT', product) %}
        <a href="{{ path('product_edit', {'id': product.id}) }}">Редактировать</a>

        {{ include('product/_delete_form.html.twig') }}
    {% else %}
        {% if app.user.purchases.contains(product) %}
            <span>Товар куплен</span>
        {% else %}
            <a href="{{ path('payment_pay', {'id': product.id}) }}">Купить</a>
        {% endif %}
    {% endif %}

    <br>
    <a href="javascript:history.back()">Назад к списку</a>
{% endblock %}
