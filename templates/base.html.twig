<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Цифровые товары{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div>
            Меню:
            <a href="{{ path('product_index') }}">Главная</a>
            {% if app.user %}
                <a href="{{ path('product_manage') }}">Мои товары</a>
                <a href="{{ path('product_purchases') }}">Покупки</a>
                <a href="{{ path('logout') }}">Выйти</a>
            {% else %}
                <a href="{{ path('register') }}">Регистрация</a>
                <a href="{{ path('login') }}">Логин</a>
            {% endif %}
        </div>

        {% for message in app.flashes('notice') %}
            <div class="notice">
                {{ message }}
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>
